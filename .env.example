# این فایل را به .env کپی کنید و مقادیر را با اطلاعات واقعی خودتان پر کنید.
# اگر این فایل (یا .env) وجود نداشته باشد، پروژه به‌صورت پیش‌فرض از SQLite استفاده می‌کند
# و هیچ تنظیم اضافه‌ای لازم نیست.

# برای فعال کردن MySQL این خط را بگذارید (هر مقدار دیگری یا نبودنش یعنی SQLite):
DB_ENGINE=mysql
DB_NAME=karkard
DB_USER=karkard_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# اختیاری: در تولید حتما این‌ها را هم تنظیم کنید
# DJANGO_SECRET_KEY=یک-کلید-تصادفی-طولانی-و-محرمانه
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=calender.decaesed.ir

# Security
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
